        <DataTemplate x:Key="ComboBoxValueNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    CornerRadius="2"
                    Width="150"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollapsedNodeBackgroundTemplate}" />
                    <Grid ColumnDefinitions="*,Auto" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Node.Metadata.Shared.GenericTypes[0], Converter={StaticResource EnumGetValuesConverter}}"
                                  SelectedItem="{Binding Node.Value}"
                                  VerticalContentAlignment="Center"
                                  VerticalAlignment="Center"
                                  Height="18"
                                  Margin="2">
                        </ComboBox>
                        <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ValueOutputCollapsedContainerTemplate}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="KeybindValueNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    CornerRadius="2"
                    BorderThickness="1"
                    Width="200"
                    BorderBrush="{DynamicResource CForeground2}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollapsedNodeBackgroundTemplate}" />
                    <Grid ColumnDefinitions="*,Auto" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <core:KeybindPicker Grid.Column="0" Keybind="{Binding Node.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="12" Margin="2" BorderThickness="1"
                                            Background="{StaticResource CBackground6}"/>
                        <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ValueOutputCollapsedContainerTemplate}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DisplayNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    CornerRadius="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollapsedNodeBackgroundTemplate}" />
                    <Grid ColumnDefinitions="Auto,Auto" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <Grid Grid.Column="0" VerticalAlignment="Top" Height="18">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ValueInputCollapsedContainerTemplate}" />
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   Foreground="{DynamicResource CForeground1}"
                                   Text="{Binding Node.Value, Converter={StaticResource ObjectToStringConverter}}" FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="350"
                                   Margin="4 -1.5 4 0"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PassthroughDisplayNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    CornerRadius="2"
                    BorderThickness="1"
                    Width="250"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollapsedNodeBackgroundTemplate}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <Grid Grid.Column="0" VerticalAlignment="Top" Height="18">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ValueInputCollapsedContainerTemplate}" />
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   Foreground="{DynamicResource CForeground1}"
                                   Text="{Binding Node.Value, Converter={StaticResource ObjectToStringConverter}}" FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="4 -1.5 4 0"
                                   FontWeight="SemiBold"/>
                        <Grid Grid.Column="2" VerticalAlignment="Top" Height="18">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ValueOutputCollapsedContainerTemplate}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CollapsedNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    CornerRadius="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollapsedNodeBackgroundTemplate}" />
                    <Grid Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            Grid.Column="0"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource ValueInputCollapsedContainerTemplate}" />
                        <Grid Grid.Column="1" VerticalAlignment="Stretch" Margin="4 0" MinHeight="18">
                            <TextBlock Foreground="{DynamicResource CForeground1}"
                                       Text="{Binding Node.DisplayName}" FontSize="12"
                                       Margin="0 -1.5 0 0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontWeight="SemiBold"
                                       Visibility="{Binding Node.Metadata.Shared.Icons, Converter={StaticResource CollectionIsEmptyToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding Node.Metadata.Shared.Icons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type fontAwesome6:EFontAwesomeIcon}">
                                        <fa6:FontAwesome Icon="{Binding}" FontSize="20"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource CForeground2}"
                                                Margin="0 5"
                                                TextAlignment="Center"
                                                FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <ContentPresenter
                            Grid.Column="2"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource ValueOutputCollapsedContainerTemplate}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SourceNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    Width="200"
                    CornerRadius="10"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeBackgroundTemplate}" />
                    <StackPanel VerticalAlignment="Top">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeHeaderTemplate}" />
                        <Grid ColumnDefinitions="*,Auto" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                            <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource ValueInputContainerTemplate}" />
                            <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ValueOutputContainerTemplate}" />
                        </Grid>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeFooterTemplate}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RegularNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    Width="202"
                    CornerRadius="10"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeBackgroundTemplate}" />
                    <StackPanel VerticalAlignment="Top">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeHeaderTemplate}" />
                        <StackPanel VerticalAlignment="Top" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                            <Grid VerticalAlignment="Top">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FlowInputContainerTemplate}" />
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FlowOutputContainerTemplate}" />
                            </Grid>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ValueOutputContainerTemplate}" />
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ValueInputContainerTemplate}" />
                        </StackPanel>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeFooterTemplate}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CallNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    Width="100"
                    CornerRadius="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollapsedNodeBackgroundTemplate}" />
                    <Grid Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <core:TextButton Grid.Column="0" Text="Call" FontSize="14"
                                         CornerRadius="2" Tag="{Binding}" Cursor="Arrow" Margin="2" Click="CallNode_OnClick" Focusable="True" ButtonColour="Gray"/>
                        <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource FlowOutputCollapsedContainerTemplate}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RelayNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    CornerRadius="2"
                    BorderThickness="1"
                    Width="15"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollapsedNodeBackgroundTemplate}" />
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ContentPresenter
                                Grid.Column="0"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource ValueInputCollapsedContainerTemplate}" />
                        <ContentPresenter
                            Grid.Column="2"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource ValueOutputCollapsedContainerTemplate}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:GroupViewModel}">
            <Border Name="GroupContainer"
                    Tag="{Binding}"
                    CornerRadius="20"
                    Cursor="Hand"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GroupContainer_OnMouseDown"
                    ContextMenu="{StaticResource GroupContextMenu}"
                    Width="{Binding Width, Mode=OneWay}"
                    Height="{Binding Height, Mode=OneWay}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}"/>
                </Border.RenderTransform>
                <Grid>
                    <Border Background="{DynamicResource CBackground1}" Opacity="0.5" CornerRadius="20"/>
                    <Grid Height="35" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Border Background="{DynamicResource CBackground3}" Opacity="0.65" CornerRadius="20 20 0 0"/>
                        <core:EditableText Text="{Binding Group.Title.Value, Mode=TwoWay}"
                                           Margin="10 0"
                                           HorizontalAlignment="Center"
                                           EditCompleted="OnGroupTitleEditCompleted"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ConnectionViewModel}">
            <ContentPresenter Content="{Binding Path, Mode=OneWay}"/>
        </DataTemplate>

        <templates:GraphElementDataTemplateSelector x:Key="GraphElementDataTemplateSelector"
                                         CastNode="{StaticResource RelayNodeTemplate}"
                                         CollapsedNode="{StaticResource CollapsedNodeTemplate}"
                                         RegularNode="{StaticResource RegularNodeTemplate}"
                                         SourceNode="{StaticResource SourceNodeTemplate}"
                                         CallNode="{StaticResource CallNodeTemplate}"
                                         DisplayNode="{StaticResource DisplayNodeTemplate}"
                                         PassthroughDisplayNode="{StaticResource PassthroughDisplayNodeTemplate}"
                                         RelayNode="{StaticResource RelayNodeTemplate}"
                                         CheckBoxValueNode="{StaticResource CheckBoxValueNodeTemplate}"
                                         TextBoxValueNode="{StaticResource TextBoxValueNodeTemplate}"
                                         ComboBoxValueNode="{StaticResource ComboBoxValueNodeTemplate}"
                                         KeybindValueNode="{StaticResource KeybindValueNodeTemplate}"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CBackground1}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Canvas x:Name="GraphCanvas">
                    <Grid x:Name="GraphContainer"
                          Width="{Binding GraphSize, Mode=OneTime}"
                          Height="{Binding GraphSize, Mode=OneTime}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Focusable="True"
                          ContextMenu="{StaticResource GraphContextMenu}">
                        <Grid.RenderTransform>
                            <MatrixTransform />
                        </Grid.RenderTransform>
                        <controls:GridBackground BackgroundBrush="{DynamicResource CBackground2}"
                                                 MajorLineBrush="{DynamicResource CBackground6}"
                                                 MinorLineBrush="{DynamicResource CBackground1}"/>
                        <ItemsControl x:Name="GraphElementItemsControl"
                                      ItemsSource="{Binding GraphElements}"
                                      ItemTemplateSelector="{StaticResource GraphElementDataTemplateSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Grid.ZIndex" Value="{Binding ZIndex}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                        <Path x:Name="ConnectionDragPath"
                              Stroke="LawnGreen"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              IsHitTestVisible="False"
                              Visibility="Collapsed">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure>
                                        <BezierSegment />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <Border x:Name="SelectionVisual"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Focusable="True"
                                CornerRadius="2" BorderThickness="1"
                                BorderBrush="{DynamicResource CForeground3}"
                                ContextMenu="{StaticResource SelectionContextMenu}"
                                MouseDown="SelectionVisual_OnMouseDown">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                            <Border Background="{DynamicResource CBackground6}" Opacity="0.25" CornerRadius="2"/>
                        </Border>
                    </Grid>
                </Canvas>
                <Border Background="{DynamicResource CBackground7}" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="0 0 10 10">
                    <core:EditableText Text="{Binding Graph.Name.Value, Mode=TwoWay}"
                                       FontSize="22"
                                       EditCompleted="OnGraphTitleEditCompleted"/>
                </Border>
            </Grid>
            <Border Grid.Column="1" Background="{DynamicResource CBackground3}">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0 2 0 0" Text="Variables" Foreground="{DynamicResource CForeground1}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <core:SpacedStackPanel Spacing="5">
                            <ItemsControl Background="Transparent" ItemsSource="{Binding GraphVariablesSource}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <core:SpacedStackPanel Spacing="5" Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type sdkNodes:IGraphVariable}">
                                        <Border Background="{DynamicResource CBackground4}" VerticalAlignment="Top" CornerRadius="5">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Create Source" Tag="{Binding}" Click="CreateVariableSource_OnClick"/>
                                                    <MenuItem Header="Create Reference" Tag="{Binding}" Click="CreateVariableReference_OnClick"/>
                                                    <MenuItem Header="Create Write" Tag="{Binding}" Click="CreateVariableWrite_OnClick"/>
                                                    <MenuItem Header="Create Drive" Tag="{Binding}" Click="CreateVariableDrive_OnClick"/>
                                                    <MenuItem Header="Delete" Tag="{Binding}" Click="DeleteVariable_OnClick"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel VerticalAlignment="Top" MaxHeight="400">
                                                <Grid>
                                                    <Border Background="{DynamicResource CBackground1}" VerticalAlignment="Top" Padding="0 2">
                                                        <Border.Clip>
                                                            <MultiBinding Converter="{StaticResource BorderClipConverter}">
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type Border}, AncestorLevel=1}" />
                                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType={x:Type Border}, AncestorLevel=1}" />
                                                                <Binding Path="CornerRadius" RelativeSource="{RelativeSource AncestorType={x:Type Border}, AncestorLevel=1}" />
                                                            </MultiBinding>
                                                        </Border.Clip>
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Name.Value}" Foreground="{DynamicResource CForeground2}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"/>
                                                            <TextBlock Text="{Binding ValueType, Converter={StaticResource TypeToFriendlyNameConverter}}" Foreground="{DynamicResource CForeground3}" FontSize="12" TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <fa6:ImageAwesome Visibility="{Binding Persistent.Value, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Icon="Solid_FloppyDisk"
                                                                      PrimaryColor="{DynamicResource CBlue}" Width="17" Height="17" ToolTip="This variable is persistent"
                                                                      ToolTipService.Placement="Mouse" ToolTipService.InitialShowDelay="500"/>
                                                </Grid>
                                                <TextBlock Margin="2" Text="{Binding Value.Value, Converter={StaticResource ObjectToStringConverter}}" Foreground="{DynamicResource CForeground2}"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <core:IconButton ButtonColour="Green" Icon="Solid_Plus" VerticalAlignment="Top" Width="100" Height="20" Click="VariableAdd_OnClick"/>
                        </core:SpacedStackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="LoadingOverlay">
            <Border Background="{DynamicResource CBackground1}" />
            <core:SpacedStackPanel Orientation="Vertical" Spacing="5" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource CForeground1}" TextAlignment="Center" FontSize="30"
                           Text="Loading Graph..." />
            </core:SpacedStackPanel>
        </Grid>
    </Grid>
</UserControl>