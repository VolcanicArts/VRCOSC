<UserControl x:Class="VRCOSC.App.UI.Views.Nodes.NodeGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nodes="clr-namespace:VRCOSC.App.UI.Views.Nodes"
             xmlns:core="clr-namespace:VRCOSC.App.UI.Core"
             xmlns:fa6="http://schemas.fontawesome.com/icons/fonts"
             xmlns:sdkNodes="clr-namespace:VRCOSC.App.Nodes"
             xmlns:viewModels="clr-namespace:VRCOSC.App.UI.Views.Nodes.ViewModels"
             xmlns:converters="clr-namespace:VRCOSC.App.UI.Views.Nodes.Converters"
             xmlns:templates="clr-namespace:VRCOSC.App.UI.Views.Nodes.Templates"
             xmlns:fontAwesome6="clr-namespace:FontAwesome6;assembly=FontAwesome6.Core"
             xmlns:controls="clr-namespace:VRCOSC.App.UI.Views.Nodes.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1920" d:DesignWidth="1080"
             Focusable="True"
             d:DataContext="{d:DesignInstance nodes:NodeGraphView}">
    <UserControl.Resources>
        <core:ObjectToStringConverter x:Key="ObjectToStringConverter"/>
        <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverterInverted" True="Collapsed" False="Visible"/>
        <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverterHidden" False="Hidden"/>
        <core:StringIsNotNullOrEmptyVisibilityConverter x:Key="StringIsNotNullOrEmptyVisibilityConverter" />
        <core:TypeToBrushConverter x:Key="TypeToBrushConverter"/>
        <core:EnumGetValuesConverter x:Key="EnumGetValuesConverter"/>
        <core:CollectionIsEmptyToVisibilityConverter x:Key="CollectionIsEmptyToVisibilityConverter"/>
        <core:TypeToFriendlyNameConverter x:Key="TypeToFriendlyNameConverter"/>

        <converters:ElementListPathVisibilityConverter x:Key="ElementListPathVisibilityConverter"/>
        <converters:ElementListPointConverter x:Key="ElementListPointConverter"/>
        <converters:ConnectionItemsSourceConverter x:Key="ValueInputConnectionItemsSourceConverter" ConnectionPoint="ValueInput" />
        <converters:ConnectionItemsSourceConverter x:Key="ValueOutputConnectionItemsSourceConverter" ConnectionPoint="ValueOutput" />
        <converters:ConnectionItemsSourceConverter x:Key="FlowInputConnectionItemsSourceConverter" ConnectionPoint="FlowInput" />
        <converters:ConnectionItemsSourceConverter x:Key="FlowOutputConnectionItemsSourceConverter" ConnectionPoint="FlowOutput" />
        <converters:TypeIsStringConverter x:Key="TypeIsStringConverter"/>

        <ContextMenu x:Key="GraphContextMenu">
            <ContextMenu.Resources>
                <HierarchicalDataTemplate DataType="{x:Type sdkNodes:ContextMenuSubMenuEntry}" ItemsSource="{Binding Items}">
                    <TextBlock Text="{Binding Name}" />
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type sdkNodes:ContextMenuNodeEntry}">
                    <MenuItem Header="{Binding Name}" Click="GraphContextMenu_NodeEntry_OnClick" Tag="{Binding}"/>
                </DataTemplate>
            </ContextMenu.Resources>
        </ContextMenu>

        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem Header="Delete Node" Click="NodeContextMenu_DeleteClick" Tag="{Binding}"/>
        </ContextMenu>

        <ContextMenu x:Key="GroupContextMenu">
            <MenuItem Header="Dissolve Group" Click="GroupContextMenu_DissolveClick" Tag="{Binding}"/>
            <MenuItem Header="Delete Group" Click="GroupContextMenu_DeleteClick" Tag="{Binding}"/>
        </ContextMenu>

        <ContextMenu x:Key="SelectionContextMenu">
            <MenuItem Header="Create Group" Click="SelectionContextMenu_CreateGroupClick"/>
            <MenuItem Header="Save As Preset" Click="SelectionContextMenu_SaveAsPresetClick"/>
            <MenuItem Header="Delete All" Click="SelectionContextMenu_DeleteAllClick"/>
        </ContextMenu>

        <SolidColorBrush x:Key="FlowBrush">DeepSkyBlue</SolidColorBrush>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/VRCOSC.App;component/Fonts/#Iosevka"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ElementText">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource CForeground1}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0 -2 0 0"/>
        </Style>

        <Style TargetType="fa6:FontAwesome">
            <Setter Property="FontFamily" Value="pack://application:,,,/VRCOSC.App;component/Fonts/#Iosevka"/>
        </Style>

        <Style TargetType="fa6:FontAwesome" x:Key="IconFlow">
            <Setter Property="Icon" Value="Solid_ChevronRight" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0 0 3 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource CForeground1}" />
        </Style>

        <Style TargetType="core:IconButton" x:Key="ElementListRemoveBtn">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Icon" Value="Solid_Minus"/>
            <Setter Property="ButtonColour" Value="Red"/>
        </Style>

        <ItemsPanelTemplate x:Key="VerticalPanelTemplate">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="NodeBackgroundTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Background="{DynamicResource CBackground4}" Opacity="0.85"
                    IsHitTestVisible="False" CornerRadius="10">
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CollapsedNodeBackgroundTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Background="{DynamicResource CBackground4}" Opacity="0.85"
                    IsHitTestVisible="False" CornerRadius="2">
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FlowConnectionPointTemplate" DataType="{x:Type viewModels:ConnectionViewModel}">
            <Border Height="12" Width="6"
                    VerticalAlignment="Center"
                    Cursor="Arrow"
                    Tag="{Binding}"
                    Background="{StaticResource FlowBrush}"
                    CornerRadius="1"
                    MouseDown="Connection_OnMouseDown"
                    MouseUp="Connection_OnMouseUp">
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ValueConnectionPointTemplate" DataType="{x:Type viewModels:NodeValueOutputViewModel}">
            <Border Height="10" Width="10"
                    VerticalAlignment="Center"
                    Cursor="Arrow"
                    Tag="{Binding}"
                    Background="{Binding Element.Metadata.Shared.ValueType, Converter={StaticResource TypeToBrushConverter}}"
                    CornerRadius="5"
                    MouseDown="Connection_OnMouseDown"
                    MouseUp="Connection_OnMouseUp"
                    ToolTip="{Binding TypeName}"/>
        </DataTemplate>

        <DataTemplate x:Key="NodeHeaderTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Background="{DynamicResource CBackground1}" VerticalAlignment="Top" Margin="0 0 0 2"
                    IsHitTestVisible="False" CornerRadius="10 10 0 0">
                <StackPanel Orientation="Vertical" Margin="5 2" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                    <TextBlock Foreground="{DynamicResource CForeground2}"
                               Text="{Binding Node.DisplayName}"
                               FontSize="14"
                               Padding="10 0"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               TextWrapping="WrapWithOverflow"
                               TextAlignment="Center" />
                    <TextBlock
                        Visibility="{Binding GenericTypesToString, Converter={StaticResource StringIsNotNullOrEmptyVisibilityConverter}, Mode=OneTime}"
                        Foreground="{DynamicResource CForeground3}"
                        Text="{Binding GenericTypesToString}"
                        FontSize="12"
                        FontWeight="Regular"
                        VerticalAlignment="Top"
                        TextWrapping="WrapWithOverflow"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NodeFooterTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Background="{DynamicResource CBackground1}" VerticalAlignment="Bottom" Margin="0 2 0 0"
                    IsHitTestVisible="False" CornerRadius="0 0 10 10">
                <Border Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}"
                        Margin="0 1">
                    <TextBlock Foreground="{DynamicResource CForeground3}"
                               Text="{Binding Node.Metadata.Shared.PathRoot}"
                               FontSize="9"
                               FontWeight="Light"
                               VerticalAlignment="Center"
                               Margin="0 -1 0 0"
                               TextWrapping="WrapWithOverflow"
                               TextAlignment="Center" />
                </Border>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FlowOutputListPath" DataType="{x:Type viewModels:IConnectionPointListViewModel}">
            <Path Stroke="{DynamicResource CForeground2}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0 0 31 0"
                  StrokeThickness="2"
                  StrokeStartLineCap="Flat"
                  StrokeEndLineCap="Flat"
                  IsHitTestVisible="False"
                  Visibility="{Binding ItemsSource.Count, Converter={StaticResource ElementListPathVisibilityConverter}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="False" StartPoint="0 25">
                            <LineSegment Point="{Binding ItemsSource.Count, Converter={StaticResource ElementListPointConverter}}"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </DataTemplate>

        <DataTemplate x:Key="FlowInputListPath" DataType="{x:Type viewModels:IConnectionPointListViewModel}">
            <Path Stroke="{DynamicResource CForeground2}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="31 0 0 0"
                  StrokeThickness="2"
                  StrokeStartLineCap="Flat"
                  StrokeEndLineCap="Flat"
                  IsHitTestVisible="False"
                  Visibility="{Binding ItemsSource.Count, Converter={StaticResource ElementListPathVisibilityConverter}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="False" StartPoint="0 25">
                            <LineSegment Point="{Binding ItemsSource.Count, Converter={StaticResource ElementListPointConverter}}"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </DataTemplate>

        <DataTemplate x:Key="ValueOutputListPath" DataType="{x:Type viewModels:IConnectionPointListViewModel}">
            <Path Stroke="{DynamicResource CForeground2}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0 0 18 0"
                  StrokeThickness="2"
                  StrokeStartLineCap="Flat"
                  StrokeEndLineCap="Flat"
                  IsHitTestVisible="False"
                  Visibility="{Binding ItemsSource.Count, Converter={StaticResource ElementListPathVisibilityConverter}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="False" StartPoint="0 25">
                            <LineSegment Point="{Binding ItemsSource.Count, Converter={StaticResource ElementListPointConverter}}"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </DataTemplate>

        <DataTemplate x:Key="ValueInputListPath" DataType="{x:Type viewModels:IConnectionPointListViewModel}">
            <Path Stroke="{DynamicResource CForeground2}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="18 0 0 0"
                  StrokeThickness="2"
                  StrokeStartLineCap="Flat"
                  StrokeEndLineCap="Flat"
                  IsHitTestVisible="False"
                  Visibility="{Binding ItemsSource.Count, Converter={StaticResource ElementListPathVisibilityConverter}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="False" StartPoint="0 25">
                            <LineSegment Point="{Binding ItemsSource.Count, Converter={StaticResource ElementListPointConverter}}"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </DataTemplate>

        <DataTemplate x:Key="ElementListButtons" DataType="{x:Type viewModels:ConnectionPointListViewModel}">
            <core:SpacedStackPanel Orientation="Horizontal" VerticalAlignment="Top" Spacing="5" Height="25">
                <core:IconButton Tag="{Binding}" Width="18" Height="18" CornerRadius="4" Padding="3" Icon="Solid_Plus" ButtonColour="Green" Click="ListElementAdd_OnClick" />
                <core:IconButton Tag="{Binding}" Width="18" Height="18" CornerRadius="4" Padding="3" Icon="Solid_Minus" ButtonColour="Red" Click="ListElementRemove_OnClick"/>
            </core:SpacedStackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FlowOutputTemplate" DataType="{x:Type viewModels:NodeFlowOutputViewModel}">
            <core:SpacedStackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="25" Spacing="2" VerticalAlignment="Center">
                <TextBlock Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name}" Style="{StaticResource ElementText}"/>
                <fa6:FontAwesome Style="{StaticResource IconFlow}" />
                <Grid Name="ConnectionPointContainer" Height="12" Width="6" Tag="{Binding}">
                    <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource FlowConnectionPointTemplate}" />
                </Grid>
            </core:SpacedStackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FlowInputTemplate" DataType="{x:Type viewModels:NodeFlowInputViewModel}">
            <core:SpacedStackPanel Orientation="Horizontal" HorizontalAlignment="Left" Height="25" Spacing="4" VerticalAlignment="Center">
                <Grid Name="ConnectionPointContainer" Height="12" Width="6" Tag="{Binding}">
                    <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource FlowConnectionPointTemplate}" />
                </Grid>
                <fa6:FontAwesome Style="{StaticResource IconFlow}" />
                <TextBlock Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name}" Style="{StaticResource ElementText}"/>
            </core:SpacedStackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <core:SpacedStackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="4" Height="25">
                <Grid Name="ConnectionPointContainer" Height="10" Width="10" Tag="{Binding}">
                    <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <TextBlock Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name}" Style="{StaticResource ElementText}"/>
            </core:SpacedStackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ComboBoxValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="Auto,4,*" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Height="10" Width="10" Tag="{Binding}">
                    <ContentPresenter Content="{Binding}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="2" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBox ItemsSource="{Binding Element.Metadata.Shared.ValueType, Converter={StaticResource EnumGetValuesConverter}}"
                              SelectedItem="{Binding Element.Field}"
                              VerticalContentAlignment="Center"
                              VerticalAlignment="Center"
                              Height="18"
                              FontSize="12"
                              ToolTip="{Binding Element.Name}">
                    </ComboBox>
                </Grid>
                <TextBlock Grid.Column="2" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverterInverted}}" Text="{Binding Element.Name}" Style="{StaticResource ElementText}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="KeybindValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="Auto,4,*" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Height="10" Width="10" Tag="{Binding}">
                    <ContentPresenter Content="{Binding}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="2" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <core:KeybindPicker Grid.Column="0" Keybind="{Binding Element.Field, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="12" Margin="0 3" BorderThickness="1"
                                        Background="{StaticResource CBackground6}"
                                        ToolTip="{Binding Element.Name}"/>
                </Grid>
                <TextBlock Grid.Column="2" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverterInverted}}" Text="{Binding Element.Name}" Style="{StaticResource ElementText}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TextBoxValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="Auto,4,*" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Height="10" Width="10" Tag="{Binding}">
                    <ContentPresenter Content="{Binding}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="2" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="11"
                             VerticalContentAlignment="Center"
                             TextAlignment="Left"
                             Padding="0 -1 0 0"
                             Height="18"
                             Text="{Binding Element.Field}"
                             ToolTip="{Binding Element.Name}">
                    </TextBox>
                </Grid>
                <TextBlock Grid.Column="2" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverterInverted}}" Text="{Binding Element.Name}" Style="{StaticResource ElementText}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CheckBoxValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="Auto,4,*" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Height="10" Width="10" Tag="{Binding}">
                    <ContentPresenter Content="{Binding}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <core:SpacedStackPanel Grid.Column="2" Spacing="4" Orientation="Horizontal" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <core:VRCOSCCheckBox Width="20" Height="20" CornerRadius="2" BorderThickness="1" Padding="3" IsChecked="{Binding Element.Field}"/>
                    <TextBlock Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name}" Style="{StaticResource ElementText}"/>
                </core:SpacedStackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ValueOutputTemplate" DataType="{x:Type viewModels:NodeValueOutputViewModel}">
            <core:SpacedStackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4" Height="25">
                <TextBlock Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name}" Style="{StaticResource ElementText}"/>
                <Grid Name="ConnectionPointContainer" Height="10" Width="10" Tag="{Binding}">
                    <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
            </core:SpacedStackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FlowInputListTemplate" DataType="{x:Type viewModels:NodeFlowInputListViewModel}">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Name="FlowInputListTemplateInstance" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Left" Tag="{Binding}">
                    <ItemsControl HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding ItemsSource}"
                                  ItemTemplate="{StaticResource FlowInputTemplate}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}">
                    </ItemsControl>
                    <ContentPresenter ContentTemplate="{StaticResource ElementListButtons}" HorizontalAlignment="Left" Content="{Binding}" Margin="8 0 0 0"/>
                </StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource FlowInputListPath}" Content="{Binding}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlowOutputListTemplate" DataType="{x:Type viewModels:NodeFlowOutputListViewModel}">
            <Grid VerticalAlignment="Top" HorizontalAlignment="Right">
                <StackPanel Name="FlowOutputListTemplateInstance" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Right" Tag="{Binding}">
                    <ItemsControl HorizontalAlignment="Right" VerticalAlignment="Top" ItemsSource="{Binding ItemsSource}"
                                  ItemTemplate="{StaticResource FlowOutputTemplate}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}">
                    </ItemsControl>
                    <ContentPresenter ContentTemplate="{StaticResource ElementListButtons}" HorizontalAlignment="Right" Content="{Binding}" Margin="0 0 8 0"/>
                </StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource FlowOutputListPath}" Content="{Binding}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ValueInputListTemplate" DataType="{x:Type viewModels:NodeValueInputListViewModel}">
            <Grid VerticalAlignment="Top">
                <StackPanel Name="ValueInputListTemplateInstance" Orientation="Vertical" VerticalAlignment="Top" Tag="{Binding}">
                    <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding ItemsSource}"
                                  ItemTemplate="{StaticResource ValueInputTemplate}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}">
                    </ItemsControl>
                    <ContentPresenter ContentTemplate="{StaticResource ElementListButtons}" HorizontalAlignment="Left" Content="{Binding}" Margin="10 0 0 0"/>
                </StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource ValueInputListPath}" Content="{Binding}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ValueOutputListTemplate" DataType="{x:Type viewModels:NodeValueOutputListViewModel}">
            <Grid VerticalAlignment="Top">
                <StackPanel Name="ValueOutputListTemplateInstance" Orientation="Vertical" VerticalAlignment="Top" Tag="{Binding}">
                    <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding ItemsSource}"
                                  ItemTemplate="{StaticResource ValueOutputTemplate}"
                                  ItemsPanel="{StaticResource VerticalPanelTemplate}">
                    </ItemsControl>
                    <ContentPresenter ContentTemplate="{StaticResource ElementListButtons}" HorizontalAlignment="Right" Content="{Binding}" Margin="0 0 10 0"/>
                </StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource ValueOutputListPath}" Content="{Binding}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ValueInputCollapsedTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid Name="ConnectionPointContainer" Width="10" Height="14" Tag="{Binding}">
                <ContentPresenter Content="{Binding}"
                                  VerticalAlignment="Center"
                                  ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ValueOutputCollapsedTemplate" DataType="{x:Type viewModels:NodeValueOutputViewModel}">
            <Grid Name="ConnectionPointContainer" Width="10" Height="14" Tag="{Binding}">
                <ContentPresenter Content="{Binding}"
                                  VerticalAlignment="Center"
                                  ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlowOutputCollapsedTemplate" DataType="{x:Type viewModels:NodeFlowOutputViewModel}">
            <Grid Name="ConnectionPointContainer" Width="6" Height="12" Tag="{Binding}">
                <ContentPresenter Content="{Binding}"
                                  VerticalAlignment="Center"
                                  ContentTemplate="{StaticResource FlowConnectionPointTemplate}" />
            </Grid>
        </DataTemplate>

        <templates:ConnectionDataTemplateSelector x:Key="ConnectionDataTemplateSelector"
                                                  FlowOutput="{StaticResource FlowOutputTemplate}"
                                                  FlowOutputList="{StaticResource FlowOutputListTemplate}"
                                                  FlowInput="{StaticResource FlowInputTemplate}"
                                                  FlowInputList="{StaticResource FlowInputListTemplate}"
                                                  ValueOutput="{StaticResource ValueOutputTemplate}"
                                                  ValueOutputList="{StaticResource ValueOutputListTemplate}"
                                                  ValueInput="{StaticResource ValueInputTemplate}"
                                                  ValueInputList="{StaticResource ValueInputListTemplate}"
                                                  CheckBoxValueInput="{StaticResource CheckBoxValueInputTemplate}"
                                                  TextBoxValueInput="{StaticResource TextBoxValueInputTemplate}"
                                                  ComboBoxValueInput="{StaticResource ComboBoxValueInputTemplate}"
                                                  KeybindValueInput="{StaticResource KeybindValueInputTemplate}"/>

        <DataTemplate x:Key="FlowInputContainerTemplate">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource FlowInputConnectionItemsSourceConverter}}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Margin="-4 0 0 0"
                          ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}">
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="FlowOutputContainerTemplate">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource FlowOutputConnectionItemsSourceConverter}}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Margin="0 0 -4 0"
                          ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}">
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="ValueInputContainerTemplate">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource ValueInputConnectionItemsSourceConverter}}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}">
                <ItemsControl.RenderTransform>
                    <TranslateTransform X="-6"/>
                </ItemsControl.RenderTransform>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="ValueOutputContainerTemplate">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource ValueOutputConnectionItemsSourceConverter}}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Margin="0 0 -6 0"
                          ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}">
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="ValueInputCollapsedContainerTemplate">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource ValueInputConnectionItemsSourceConverter}}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Margin="-5.5 0 0 0"
                          ItemTemplate="{StaticResource ValueInputCollapsedTemplate}">
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="ValueOutputCollapsedContainerTemplate">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource ValueOutputConnectionItemsSourceConverter}}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Margin="0 0 -5.5 0"
                          ItemTemplate="{StaticResource ValueOutputCollapsedTemplate}">
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="FlowOutputCollapsedContainerTemplate">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource FlowOutputConnectionItemsSourceConverter}}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Margin="0 0 -3.5 0"
                          ItemTemplate="{StaticResource FlowOutputCollapsedTemplate}">
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="CheckBoxValueNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    CornerRadius="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollapsedNodeBackgroundTemplate}" />
                    <Grid ColumnDefinitions="*,Auto" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <core:VRCOSCCheckBox Grid.Column="0" Width="18" Height="18" Margin="2" CornerRadius="1" BorderThickness="1" Padding="3" IsChecked="{Binding Node.Value}"/>
                        <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ValueOutputCollapsedContainerTemplate}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TextBoxValueNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding}"
                    CornerRadius="2"
                    BorderThickness="1"
                    Width="200"
                    BorderBrush="{DynamicResource CForeground2}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="Transparent"
                    ContextMenu="{StaticResource NodeContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollapsedNodeBackgroundTemplate}" />
                    <Grid ColumnDefinitions="*,Auto" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <TextBox Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="12"
                                 Margin="2"
                                 AcceptsReturn="{Binding Node.Metadata.Shared.GenericTypes[0], Converter={StaticResource TypeIsStringConverter}}"
                                 AcceptsTab="{Binding Node.Metadata.Shared.GenericTypes[0], Converter={StaticResource TypeIsStringConverter}}"
                                 MinLines="0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Node.Value}">
