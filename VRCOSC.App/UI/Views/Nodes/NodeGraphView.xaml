                    ContextMenu="{StaticResource ElementContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <ContentPresenter Grid.Row="0" Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource NodeHeaderTemplate}" />
                    <Grid ColumnDefinitions="*,*" Grid.Row="1" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <Grid RowDefinitions="Auto,Auto" Grid.Column="0">
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding FlowInputVms, Mode=OneTime}" ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ValueInputVms, Mode=OneTime}" ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}"/>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" Grid.Column="1">
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding FlowOutputVms, Mode=OneTime}" ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ValueOutputVms, Mode=OneTime}" ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}"/>
                        </Grid>
                    </Grid>
                    <ContentPresenter Grid.Row="2" Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource NodeFooterTemplate}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RegularNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding Mode=OneTime}"
                    Width="202"
                    CornerRadius="10"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="{DynamicResource NodeBackgroundBrush}"
                    ContextMenu="{StaticResource ElementContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <ContentPresenter Grid.Row="0" Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource NodeHeaderTemplate}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding FlowInputVms, Mode=OneTime}" ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}"/>
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding FlowOutputVms, Mode=OneTime}" ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ValueOutputVms, Mode=OneTime}" ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}"/>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding ValueInputVms, Mode=OneTime}" ItemTemplateSelector="{StaticResource ConnectionDataTemplateSelector}"/>
                    </Grid>
                    <ContentPresenter Grid.Row="2" Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource NodeFooterTemplate}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ButtonNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding Mode=OneTime}"
                    Width="100"
                    CornerRadius="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="{DynamicResource NodeBackgroundBrush}"
                    ContextMenu="{StaticResource ElementContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid ColumnDefinitions="*,Auto" Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                    <core:TextButton Grid.Column="0" Text="Call" FontSize="12" CornerRadius="2" Tag="{Binding Mode=OneTime}" Cursor="Arrow" Margin="2" Click="ButtonNode_OnClick" Focusable="True" ButtonColour="Gray"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding FlowOutputVms, Mode=OneTime}" ItemTemplate="{StaticResource FlowOutputCollapsedTemplate}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RelayNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Cursor="Hand"
                    Focusable="True"
                    Tag="{Binding Mode=OneTime}"
                    CornerRadius="2"
                    BorderThickness="1"
                    Width="15"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    Background="{DynamicResource NodeBackgroundBrush}"
                    ContextMenu="{StaticResource ElementContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}" />
                </Border.RenderTransform>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding ValueInputVms, Mode=OneTime}" ItemTemplate="{StaticResource ValueInputCollapsedTemplate}" VerticalAlignment="Center"/>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding ValueOutputVms, Mode=OneTime}" ItemTemplate="{StaticResource ValueOutputCollapsedTemplate}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:GroupViewModel}">
            <Border Name="GroupContainer"
                    Tag="{Binding Mode=OneTime}"
                    CornerRadius="20"
                    Cursor="Hand"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseDown="GroupContainer_OnMouseDown"
                    ContextMenu="{StaticResource GroupContextMenu}"
                    Background="{DynamicResource GroupBackgroundBrush}"
                    Width="{Binding Width, Mode=OneWay}"
                    Height="{Binding Height, Mode=OneWay}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}"/>
                </Border.RenderTransform>
                <Grid Height="35" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Border Background="{DynamicResource CBackground1}" CornerRadius="20 20 0 0"/>
                    <core:EditableText Text="{Binding Group.Title.Value}"
                                       Margin="10 0"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       Foreground="{DynamicResource CForeground1}"
                                       EditCompleted="OnGroupTitleEditCompleted"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CommentViewModel}">
            <Border Name="CommentContainer"
                    Tag="{Binding Mode=OneTime}"
                    CornerRadius="5"
                    Cursor="Hand"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CForeground3}"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    MouseDown="GridGraphElementContainer_OnMouseDown"
                    MouseUp="GridGraphElementContainer_OnMouseUp"
                    ContextMenu="{StaticResource ElementContextMenu}">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding Position.X, Mode=OneWay}" Y="{Binding Position.Y, Mode=OneWay}"/>
                </Border.RenderTransform>
                <Grid HorizontalAlignment="Center">
                    <Border Background="{DynamicResource CBackground1}" Opacity="0.75" CornerRadius="5"/>
                    <core:EditableText Text="{Binding Comment.Text.Value}"
                                       Tag="{Binding Mode=OneTime}"
                                       Margin="5 2"
                                       MinWidth="50"
                                       FontSize="15"
                                       Foreground="{DynamicResource CForeground1}"
                                       HorizontalAlignment="Center"
                                       EditCompleted="Comment_EditCompleted"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ConnectionViewModel}">
            <ContentPresenter Content="{Binding Path, Mode=OneWay}"/>
        </DataTemplate>

        <templates:GraphElementDataTemplateSelector x:Key="GraphElementDataTemplateSelector"
                                         CastNode="{StaticResource RelayNodeTemplate}"
                                         CollapsedNode="{StaticResource CollapsedNodeTemplate}"
                                         HoistedInputNode="{StaticResource HoistedInputNodeTemplate}"
                                         NoInlineNode="{StaticResource NoInlineNodeTemplate}"
                                         RegularNode="{StaticResource RegularNodeTemplate}"
                                         SourceNode="{StaticResource SourceNodeTemplate}"
                                         DriveNode="{StaticResource DriveNodeTemplate}"
                                         ButtonNode="{StaticResource ButtonNodeTemplate}"
                                         SwitchNode="{StaticResource SwitchNodeTemplate}"
                                         DisplayNode="{StaticResource DisplayNodeTemplate}"
                                         PassthroughDisplayNode="{StaticResource PassthroughDisplayNodeTemplate}"
                                         ColorDisplayNode="{StaticResource ColorDisplayNodeTemplate}"
                                         RelayNode="{StaticResource RelayNodeTemplate}"
                                         CheckBoxValueNode="{StaticResource CheckBoxValueNodeTemplate}"
                                         TextBoxValueNode="{StaticResource TextBoxValueNodeTemplate}"
                                         TextBoxNumericValueNode="{StaticResource TextBoxNumericValueNodeTemplate}"
                                         ComboBoxValueNode="{StaticResource ComboBoxValueNodeTemplate}"
                                         KeybindValueNode="{StaticResource KeybindValueNodeTemplate}"
                                         DateTimeValueNode="{StaticResource DateTimeValueNodeTemplate}"
                                         TimeSpanValueNode="{StaticResource TimeSpanValueNodeTemplate}"
                                         ColorValueNode="{StaticResource ColorValueNodeTemplate}"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CBackground1}">
        <Grid ColumnDefinitions="*,200">
            <Grid Grid.Column="0">
                <Canvas x:Name="GraphCanvas">
                    <Grid x:Name="GraphContainer"
                          Width="{Binding GraphSize, Mode=OneTime}"
                          Height="{Binding GraphSize, Mode=OneTime}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Focusable="True"
                          ContextMenu="{StaticResource GraphContextMenu}">
                        <Grid.RenderTransform>
                            <MatrixTransform />
                        </Grid.RenderTransform>
                        <controls:GridBackground BackgroundBrush="{DynamicResource CBackground2}"
                                                 MajorLineBrush="{DynamicResource CBackground6}"
                                                 MinorLineBrush="{DynamicResource CBackground1}"/>
                        <ItemsControl x:Name="GraphElementItemsControl"
                                      ItemsSource="{Binding GraphElements}"
                                      ItemTemplateSelector="{StaticResource GraphElementDataTemplateSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Grid.ZIndex" Value="{Binding ZIndex}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                        <Path x:Name="ConnectionDragPath"
                              Stroke="LimeGreen"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              IsHitTestVisible="False"
                              Visibility="Collapsed">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure>
                                        <BezierSegment />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <Border x:Name="SelectionVisual"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Focusable="True"
                                CornerRadius="2" BorderThickness="1"
                                BorderBrush="{DynamicResource CForeground3}"
                                ContextMenu="{StaticResource SelectionContextMenu}"
                                MouseDown="SelectionVisual_OnMouseDown">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                            <Border Background="{DynamicResource CBackground6}" Opacity="0.25" CornerRadius="2"/>
                        </Border>
                    </Grid>
                </Canvas>
                <Border Background="{DynamicResource CBackground7}" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="0 0 10 10">
                    <core:EditableText Text="{Binding Graph.Name.Value, Mode=TwoWay}"
                                       FontSize="22"
                                       Margin="0 2"
                                       Foreground="{DynamicResource CForeground1}"
                                       EditCompleted="OnGraphTitleEditCompleted"/>
                </Border>
            </Grid>
            <Border Grid.Column="1" Background="{DynamicResource CBackground3}">
                <Grid RowDefinitions="25,5,*" Margin="0 5 0 0">
                    <TextBlock Grid.Row="0" Margin="0 2 0 0" Text="Variables" Foreground="{DynamicResource CForeground1}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <core:SpacedStackPanel Spacing="5">
                            <ItemsControl Background="Transparent" ItemsSource="{Binding GraphVariablesSource}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <core:SpacedStackPanel Spacing="5" Orientation="Vertical" Margin="5 0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type sdkNodes:IGraphVariable}">
                                        <Border Background="{DynamicResource CBackground4}" VerticalAlignment="Top" CornerRadius="5"
                                                ContextMenu="{StaticResource VariableContextMenu}">
                                            <StackPanel VerticalAlignment="Top" MaxHeight="400">
                                                <Grid>
                                                    <Border Background="{DynamicResource CBackground1}" VerticalAlignment="Top" Padding="0 2">
                                                        <Border.Clip>
                                                            <MultiBinding Converter="{StaticResource BorderClipConverter}">
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type Border}, AncestorLevel=1}" />
                                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType={x:Type Border}, AncestorLevel=1}" />
                                                                <Binding Path="CornerRadius" RelativeSource="{RelativeSource AncestorType={x:Type Border}, AncestorLevel=1}" />
                                                            </MultiBinding>
                                                        </Border.Clip>
                                                        <Grid RowDefinitions="Auto,Auto">
                                                            <core:EditableText Grid.Row="0"
                                                                               Foreground="{DynamicResource CForeground1}"
                                                                               Text="{Binding Name.Value}"
                                                                               FontSize="14"
                                                                               Tag="{Binding}"
                                                                               Padding="10 0"
                                                                               FontWeight="Regular"
                                                                               HorizontalAlignment="Center"
                                                                               EditCompleted="VariableName_EditCompleted"
                                                                               ToolTip="{Binding Name.Value}"/>
                                                            <TextBlock Grid.Row="1"
                                                                       Foreground="{DynamicResource CForeground3}"
                                                                       Text="{Binding ValueType, Converter={StaticResource TypeToFriendlyNameConverter}}"
                                                                       FontSize="12"
                                                                       Padding="10 0"
                                                                       FontWeight="Regular"
                                                                       HorizontalAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                    <fa6:ImageAwesome Visibility="{Binding Persistent.Value, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Icon="Solid_FloppyDisk"
                                                                      PrimaryColor="{DynamicResource CBlue}" Width="17" Height="17" ToolTip="This variable is persistent"/>
                                                </Grid>
                                                <TextBlock Margin="2" Text="{Binding Value.Value, Converter={StaticResource ObjectToStringConverter}}" Foreground="{DynamicResource CForeground2}"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <core:IconButton ButtonColour="Green" Icon="Solid_Plus" VerticalAlignment="Top" Width="100" Height="20" Click="VariableAdd_OnClick" Margin="0 0 0 5"/>
                        </core:SpacedStackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="LoadingOverlay">
            <Border Background="{DynamicResource CBackground1}" />
            <core:SpacedStackPanel Orientation="Vertical" Spacing="5" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource CForeground1}" TextAlignment="Center" FontSize="30"
                           Text="Loading Graph..." />
            </core:SpacedStackPanel>
        </Grid>
    </Grid>
</UserControl>