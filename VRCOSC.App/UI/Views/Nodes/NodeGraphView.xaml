<UserControl x:Class="VRCOSC.App.UI.Views.Nodes.NodeGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nodes="clr-namespace:VRCOSC.App.UI.Views.Nodes"
             xmlns:core="clr-namespace:VRCOSC.App.UI.Core"
             xmlns:fa6="http://schemas.fontawesome.com/icons/fonts"
             xmlns:sdkNodes="clr-namespace:VRCOSC.App.Nodes"
             xmlns:viewModels="clr-namespace:VRCOSC.App.UI.Views.Nodes.ViewModels"
             xmlns:converters="clr-namespace:VRCOSC.App.UI.Views.Nodes.Converters"
             xmlns:templates="clr-namespace:VRCOSC.App.UI.Views.Nodes.Templates"
             xmlns:fontAwesome6="clr-namespace:FontAwesome6;assembly=FontAwesome6.Core"
             xmlns:controls="clr-namespace:VRCOSC.App.UI.Views.Nodes.Controls"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:colorPicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             mc:Ignorable="d"
             d:DesignHeight="1920" d:DesignWidth="1080"
             Focusable="True"
             d:DataContext="{d:DesignInstance nodes:NodeGraphView}">
    <UserControl.Resources>
        <core:ObjectToStringConverter x:Key="ObjectToStringConverter"/>
        <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <core:ColorToWindowsColorConverter x:Key="ColorToWindowsColorConverter"/>
        <core:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverterHidden" False="Hidden"/>
        <core:StringIsNotNullOrEmptyVisibilityConverter x:Key="StringIsNotNullOrEmptyVisibilityConverter" />
        <core:TypeToBrushConverter x:Key="TypeToBrushConverter"/>
        <core:EnumGetValuesConverter x:Key="EnumGetValuesConverter"/>
        <core:CollectionIsEmptyToVisibilityConverter x:Key="CollectionIsEmptyToVisibilityConverter"/>
        <core:TypeToFriendlyNameConverter x:Key="TypeToFriendlyNameConverter"/>

        <converters:ElementListPathVisibilityConverter x:Key="ElementListPathVisibilityConverter"/>
        <converters:ElementListPointConverter x:Key="ElementListPointConverter"/>
        <converters:InputNameVisibilityConverter x:Key="InputNameVisibilityConverter"/>

        <ContextMenu x:Key="GraphContextMenu">
            <ContextMenu.Resources>
                <HierarchicalDataTemplate DataType="{x:Type sdkNodes:ContextMenuSubMenuEntry}" ItemsSource="{Binding Items}">
                    <TextBlock Text="{Binding Name}" />
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type sdkNodes:ContextMenuNodeEntry}">
                    <MenuItem Header="{Binding Name}" Click="GraphContextMenu_NodeEntry_OnClick" Tag="{Binding}"/>
                </DataTemplate>
            </ContextMenu.Resources>
        </ContextMenu>

        <ContextMenu x:Key="VariableContextMenu">
            <MenuItem Header="Create Source" Tag="{Binding}" Click="CreateVariableSource_OnClick"/>
            <MenuItem Header="Create Reference" Tag="{Binding}" Click="CreateVariableReference_OnClick"/>
            <MenuItem Header="Create Write" Tag="{Binding}" Click="CreateVariableWrite_OnClick"/>
            <MenuItem Header="Create Drive" Tag="{Binding}" Click="CreateVariableDrive_OnClick"/>
            <MenuItem Header="Delete" Tag="{Binding}" Click="DeleteVariable_OnClick"/>
        </ContextMenu>

        <ContextMenu x:Key="ElementContextMenu">
            <MenuItem Header="Delete" Click="ElementContextMenu_DeleteClick" Tag="{Binding}"/>
        </ContextMenu>

        <ContextMenu x:Key="GroupContextMenu">
            <MenuItem Header="Dissolve Group" Click="GroupContextMenu_DissolveClick" Tag="{Binding}"/>
            <MenuItem Header="Delete Group" Click="GroupContextMenu_DeleteClick" Tag="{Binding}"/>
        </ContextMenu>

        <ContextMenu x:Key="SelectionContextMenu">
            <MenuItem Header="Create Group" Click="SelectionContextMenu_CreateGroupClick"/>
            <MenuItem Header="Create Preset" Click="SelectionContextMenu_SaveAsPresetClick"/>
            <MenuItem Header="Delete All" Click="SelectionContextMenu_DeleteAllClick"/>
        </ContextMenu>

        <SolidColorBrush x:Key="FlowBrush">DeepSkyBlue</SolidColorBrush>
        <SolidColorBrush x:Key="NodeBackgroundBrush" Color="{DynamicResource CBackground4Color}" Opacity="0.85" />
        <SolidColorBrush x:Key="GroupBackgroundBrush" Color="{DynamicResource CBackground1Color}" Opacity="0.5" />

        <Style TargetType="TextBlock" x:Key="ElementText">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource CForeground1}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0 -2 0 0"/>
        </Style>

        <Style TargetType="fa6:FontAwesome" x:Key="IconFlow">
            <Setter Property="Icon" Value="Solid_ChevronRight" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource CForeground1}" />
        </Style>

        <DataTemplate x:Key="FlowConnectionPointTemplate" DataType="{x:Type viewModels:ConnectionViewModel}">
            <Border Height="12" Width="6"
                    VerticalAlignment="Center"
                    Cursor="Arrow"
                    Tag="{Binding Mode=OneTime}"
                    Background="{StaticResource FlowBrush}"
                    CornerRadius="1"
                    MouseDown="Connection_OnMouseDown"
                    MouseUp="Connection_OnMouseUp">
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ValueConnectionPointTemplate" DataType="{x:Type viewModels:ConnectionPointViewModel}">
            <Border Height="10" Width="10"
                    VerticalAlignment="Center"
                    Cursor="Arrow"
                    Tag="{Binding}"
                    Background="{Binding Element.Metadata.Shared.ValueType, Converter={StaticResource TypeToBrushConverter}, Mode=OneTime}"
                    CornerRadius="5"
                    MouseDown="Connection_OnMouseDown"
                    MouseUp="Connection_OnMouseUp"
                    ToolTip="{Binding TypeName}"/>
        </DataTemplate>

        <DataTemplate x:Key="NodeHeaderTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Background="{DynamicResource CBackground1}"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Padding="5 2 5 4"
                    CornerRadius="10 10 0 0">
                <Grid RowDefinitions="Auto,Auto"
                      Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}">
                    <TextBlock Grid.Row="0"
                               Foreground="{DynamicResource CForeground1}"
                               Text="{Binding DisplayName}"
                               FontSize="14"
                               Padding="10 0"
                               FontWeight="Regular"
                               VerticalAlignment="Top"
                               TextWrapping="WrapWithOverflow"
                               TextAlignment="Center" />
                    <TextBlock Grid.Row="1"
                               Visibility="{Binding GenericTypesToString, Converter={StaticResource StringIsNotNullOrEmptyVisibilityConverter}, Mode=OneTime}"
                               Foreground="{DynamicResource CForeground3}"
                               Text="{Binding GenericTypesToString, Mode=OneTime}"
                               FontSize="10"
                               FontWeight="Regular"
                               VerticalAlignment="Top"
                               TextWrapping="WrapWithOverflow"
                               TextAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NodeFooterTemplate" DataType="{x:Type viewModels:NodeViewModel}">
            <Border Background="{DynamicResource CBackground1}" VerticalAlignment="Bottom"
                    IsHitTestVisible="False" CornerRadius="0 0 10 10">
                <Border Visibility="{Binding ShowDetails.Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverterHidden}}"
                        Margin="0 1">
                    <TextBlock Foreground="{DynamicResource CForeground3}"
                               Text="{Binding Node.Metadata.Shared.PathRoot, Mode=OneTime}"
                               FontSize="9"
                               FontWeight="Light"
                               VerticalAlignment="Center"
                               Margin="0 -1 0 0"
                               TextWrapping="WrapWithOverflow"
                               TextAlignment="Center" />
                </Border>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InputElementListPath" DataType="{x:Type viewModels:IConnectionPointListViewModel}">
            <Path Stroke="{DynamicResource CForeground2}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Flat"
                  StrokeEndLineCap="Flat"
                  IsHitTestVisible="False"
                  Margin="1 0 0 0"
                  Visibility="{Binding ItemsSource.Count, Converter={StaticResource ElementListPathVisibilityConverter}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="False" StartPoint="0 25">
                            <LineSegment Point="{Binding ItemsSource.Count, Converter={StaticResource ElementListPointConverter}}"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </DataTemplate>

        <DataTemplate x:Key="OutputElementListPath" DataType="{x:Type viewModels:IConnectionPointListViewModel}">
            <Path Stroke="{DynamicResource CForeground2}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Flat"
                  StrokeEndLineCap="Flat"
                  IsHitTestVisible="False"
                  Visibility="{Binding ItemsSource.Count, Converter={StaticResource ElementListPathVisibilityConverter}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="False" StartPoint="0 25">
                            <LineSegment Point="{Binding ItemsSource.Count, Converter={StaticResource ElementListPointConverter}}"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </DataTemplate>

        <DataTemplate x:Key="ElementListButtons" DataType="{x:Type viewModels:ConnectionPointListViewModel}">
            <Grid ColumnDefinitions="Auto,5,Auto" Height="25">
                <core:IconButton Grid.Column="0" Tag="{Binding Mode=OneTime}" Width="18" Height="18" CornerRadius="4" Padding="3" Icon="Solid_Plus" ButtonColour="Green" Click="ListElementAdd_OnClick" />
                <core:IconButton Grid.Column="2" Tag="{Binding Mode=OneTime}" Width="18" Height="18" CornerRadius="4" Padding="3" Icon="Solid_Minus" ButtonColour="Red" Click="ListElementRemove_OnClick"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ComboBoxElementTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <ComboBox ItemsSource="{Binding Element.Metadata.Shared.ValueType, Converter={StaticResource EnumGetValuesConverter}, Mode=OneTime}"
                      SelectedItem="{Binding Element.Field}"
                      VerticalContentAlignment="Center"
                      VerticalAlignment="Center"
                      Height="18"
                      FontSize="9"
                      ToolTip="{Binding Element.Name, Mode=OneTime}">
            </ComboBox>
        </DataTemplate>

        <DataTemplate x:Key="TextBoxElementTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <xctk:WatermarkTextBox HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="11"
                                   VerticalContentAlignment="Center"
                                   TextAlignment="Left"
                                   Padding="0 -1 0 0"
                                   Height="18"
                                   KeepWatermarkOnGotFocus="True"
                                   Watermark="{Binding Element.Name, Mode=OneTime}"
                                   Background="{DynamicResource CBackground3}"
                                   Foreground="{DynamicResource CForeground1}"
                                   Text="{Binding Element.Field}"
                                   ToolTip="{Binding Element.Name, Mode=OneTime}">
                <xctk:WatermarkTextBox.WatermarkTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mode=OneTime}" HorizontalAlignment="Center" Foreground="{DynamicResource CForeground1}" Margin="3 0" Opacity="0.5"/>
                    </DataTemplate>
                </xctk:WatermarkTextBox.WatermarkTemplate>
            </xctk:WatermarkTextBox>
        </DataTemplate>

        <DataTemplate x:Key="KeybindElementTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <core:KeybindPicker Keybind="{Binding Element.Field}"
                                Height="18"
                                FontSize="12" BorderThickness="1"
                                Background="{DynamicResource CBackground6}"
                                ToolTip="{Binding Element.Name, Mode=OneTime}"/>
        </DataTemplate>

        <DataTemplate x:Key="DateTimeElementTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <xctk:DateTimePicker HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 Height="18"
                                 Padding="0 -2 0 0"
                                 Background="{DynamicResource CBackground3}"
                                 Foreground="{DynamicResource CForeground1}"
                                 Value="{Binding Element.Field}" ToolTip="{Binding Element.Name, Mode=OneTime}"/>
        </DataTemplate>

        <DataTemplate x:Key="TimeSpanElementTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <xctk:TimeSpanUpDown VerticalAlignment="Center"
                                 Height="18"
                                 Padding="0 -2 0 0"
                                 Background="{DynamicResource CBackground3}"
                                 Foreground="{DynamicResource CForeground1}"
                                 Value="{Binding Element.Field}" ToolTip="{Binding Element.Name, Mode=OneTime}"/>
        </DataTemplate>

        <DataTemplate x:Key="ColorElementTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <colorPicker:PortableColorPicker Tag="{Binding}" SelectedColor="{Binding Element.Field, Mode=OneTime, Converter={StaticResource ColorToWindowsColorConverter}}" ColorChanged="PickerControlBase_OnColorChanged" Height="18" Focusable="True" Style="{DynamicResource DefaultColorPickerStyle}"/>
        </DataTemplate>

        <DataTemplate x:Key="CheckBoxElementTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <core:VRCOSCCheckBox Width="18" Height="18" CornerRadius="2" BorderThickness="1" Padding="3" IsChecked="{Binding Element.Field}"/>
        </DataTemplate>

        <DataTemplate x:Key="FlowOutputTemplate" DataType="{x:Type viewModels:NodeFlowOutputViewModel}">
            <Grid ColumnDefinitions="6,*,6" Height="25">
                <Grid Grid.Column="1" ColumnDefinitions="*,3,Auto" HorizontalAlignment="Right">
                    <TextBlock Grid.Column="0" Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}"/>
                    <fa6:FontAwesome Grid.Column="2" Style="{StaticResource IconFlow}" />
                </Grid>
                <Grid Grid.Column="2" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="0 0 -8 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      ContentTemplate="{StaticResource FlowConnectionPointTemplate}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlowInputTemplate" DataType="{x:Type viewModels:NodeFlowInputViewModel}">
            <Grid ColumnDefinitions="6,*,6" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="-8 0 0 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      ContentTemplate="{StaticResource FlowConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,3,*">
                    <fa6:FontAwesome Grid.Column="0" Style="{StaticResource IconFlow}" />
                    <TextBlock Grid.Column="2" Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="10,*,10" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="-12 0 0 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <TextBlock Grid.Column="1" Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ComboBoxValueCollapsedTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid Margin="2 0" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource ComboBoxElementTemplate}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ComboBoxValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="10,*,10" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="-12 0 0 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="1" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource ComboBoxElementTemplate}"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource InputNameVisibilityConverter}">
                            <Binding Path="RenderInline"/>
                            <Binding Path="RenderName"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="KeybindValueCollapsedTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid Margin="2 0" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource KeybindElementTemplate}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="KeybindValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="10,*,10" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="-12 0 0 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="1" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource KeybindElementTemplate}"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource InputNameVisibilityConverter}">
                            <Binding Path="RenderInline"/>
                            <Binding Path="RenderName"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TextBoxValueCollapsedTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid Margin="2 0" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource TextBoxElementTemplate}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TextBoxValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="10,*,10" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="-12 0 0 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="1" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource TextBoxElementTemplate}"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource InputNameVisibilityConverter}">
                            <Binding Path="RenderInline"/>
                            <Binding Path="RenderName"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DateTimeValueCollapsedTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid Margin="2 0" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource DateTimeElementTemplate}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DateTimeValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="10,*,10" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="-12 0 0 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="1" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource DateTimeElementTemplate}"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource InputNameVisibilityConverter}">
                            <Binding Path="RenderInline"/>
                            <Binding Path="RenderName"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TimeSpanValueCollapsedTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid Margin="2 0" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource TimeSpanElementTemplate}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TimeSpanValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="10,*,10" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="-12 0 0 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="1" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource TimeSpanElementTemplate}"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource InputNameVisibilityConverter}">
                            <Binding Path="RenderInline"/>
                            <Binding Path="RenderName"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ColorValueCollapsedTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid Margin="2 0" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource ColorElementTemplate}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ColorValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="10,*,10" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="-12 0 0 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="1" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource ColorElementTemplate}"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource InputNameVisibilityConverter}">
                            <Binding Path="RenderInline"/>
                            <Binding Path="RenderName"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CheckBoxValueCollapsedTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid Margin="2 0" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentPresenter Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource CheckBoxElementTemplate}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CheckBoxValueInputTemplate" DataType="{x:Type viewModels:NodeValueInputViewModel}">
            <Grid ColumnDefinitions="10,*,10" Height="25">
                <Grid Grid.Column="0" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="-12 0 0 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      Visibility="{Binding RenderConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                    <ContentPresenter Grid.Column="0" Margin="0 0 5 0" Content="{Binding Mode=OneTime}" ContentTemplate="{StaticResource CheckBoxElementTemplate}" Visibility="{Binding RenderInline, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Grid.Column="1" Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ValueOutputTemplate" DataType="{x:Type viewModels:NodeValueOutputViewModel}">
            <Grid ColumnDefinitions="10,*,10" Height="25">
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Visibility="{Binding RenderName, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding Element.Name, Mode=OneTime}" Style="{StaticResource ElementText}"/>
                <Grid Grid.Column="2" Name="ConnectionPointContainer" Tag="{Binding Mode=OneTime}" Margin="0 0 -12 0">
                    <ContentPresenter Content="{Binding Mode=OneTime}"
                                      ContentTemplate="{StaticResource ValueConnectionPointTemplate}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlowInputListTemplate" DataType="{x:Type viewModels:NodeFlowInputListViewModel}">
            <Grid RowDefinitions="Auto,Auto" Name="FlowInputListTemplateInstance" Tag="{Binding Mode=OneTime}">
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding ItemsSource}"
                              ItemTemplate="{StaticResource FlowInputTemplate}" />
                <ContentPresenter Grid.Row="1"
                                  Content="{Binding Mode=OneTime}"
                                  ContentTemplate="{StaticResource ElementListButtons}"
                                  HorizontalAlignment="Left"
                                  Margin="10 0 0 0" />
                <ContentPresenter Margin="24 0 0 0"
                                  HorizontalAlignment="Left"
                                  Content="{Binding Mode=OneTime}"
                                  ContentTemplate="{StaticResource InputElementListPath}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlowOutputListTemplate" DataType="{x:Type viewModels:NodeFlowOutputListViewModel}">
            <Grid RowDefinitions="Auto,Auto" Name="FlowOutputListTemplateInstance" Tag="{Binding Mode=OneTime}">
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding ItemsSource}"
                              ItemTemplate="{StaticResource FlowOutputTemplate}" />
                <ContentPresenter Grid.Row="1"
                                  Content="{Binding Mode=OneTime}"
                                  ContentTemplate="{StaticResource ElementListButtons}"
                                  HorizontalAlignment="Right"
                                  Margin="0 0 10 0" />
                <ContentPresenter Margin="0 0 24 0"
                                  HorizontalAlignment="Right"
                                  Content="{Binding Mode=OneTime}"
                                  ContentTemplate="{StaticResource OutputElementListPath}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ValueInputListTemplate" DataType="{x:Type viewModels:NodeValueInputListViewModel}">
