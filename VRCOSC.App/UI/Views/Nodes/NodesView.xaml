<UserControl x:Class="VRCOSC.App.UI.Views.Nodes.NodesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:VRCOSC.App.UI.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignData Source=/UI/Views/Nodes/NodesView.xaml}"
             d:DesignHeight="1920" d:DesignWidth="1080">
    <UserControl.Resources>
        <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverterInverted" True="Collapsed" False="Visible"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ContentPresenter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" x:Name="ActiveField"/>
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource CBackground3}"/>
        <Grid Grid.Column="0" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="GraphsTab" MouseDown="GraphsTab_OnMouseDown">
                <TextBlock Text="Graphs" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource CForeground1}"/>
            </Grid>
            <Grid x:Name="PresetsTab" MouseDown="PresetsTab_OnMouseDown" Grid.Column="1">
                <TextBlock Text="Presets" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource CForeground1}"/>
            </Grid>
        </Grid>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid x:Name="GraphsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource CBackground1}" Padding="12 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <core:IconButton ButtonColour="Blue"
                                         Icon="Solid_Download"
                                         Height="24"
                                         Click="ImportGraph_OnClick"
                                         ToolTip="Import Graph"
                                         ToolTipService.Placement="Bottom"
                                         ToolTipService.InitialShowDelay="500"/>
                        <core:IconButton Grid.Column="2"
                                        ButtonColour="Green"
                                        Icon="Solid_Plus"
                                        Height="24"
                                        Click="CreateGraph_OnClick"
                                        ToolTip="Create New Graph"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.InitialShowDelay="500"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding GraphsSource, Mode=OneWay}" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <core:SpacedStackPanel Spacing="6" Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6"
                                        Tag="{Binding}"
                                        ToolTip="{Binding Name.Value}"
                                        ToolTipService.Placement="Mouse"
                                        ToolTipService.InitialShowDelay="500"
                                        Padding="12 10"
                                        BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CBackground2}"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CBackground4}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CBackground6}"/>
                                                </Trigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Selected.Value}" Value="True"/>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource CBackground5}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CBackground8}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Selected.Value}" Value="True"/>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource CBackground5}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CBackground8}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <core:VRCOSCCheckBox Grid.Column="0"
                                                 IsChecked="{Binding Enabled.Value, Mode=TwoWay}"
                                                 VerticalAlignment="Center"
                                                 Margin="0 0 12 0"
                                                 Width="24"
                                                 Height="24">
                                        </core:VRCOSCCheckBox>

                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Name.Value}"
                                                  FontSize="14"
                                                  VerticalAlignment="Center"
                                                  TextTrimming="CharacterEllipsis"
                                                  MouseDown="GraphTab_OnClick"
                                                  Margin="0 -2 0 0"
                                                  Tag="{Binding}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource CForeground1}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled.Value}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource CForeground3}"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="2"
                                               Width="8"
                                               Height="8"
                                               CornerRadius="4"
                                               Margin="12 0 0 0"
                                               VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CRed}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Running.Value}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CGreen}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Export" Click="ExportGraph_OnClick" Tag="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Delete" Click="DeleteGraph_OnClick" Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="PresetsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource CBackground1}" Padding="12 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <core:IconButton ButtonColour="Blue"
                                         Icon="Solid_Download"
                                         Height="24"
                                         Click="ImportPreset_OnClick"
                                         ToolTip="Import Preset"
                                         ToolTipService.Placement="Bottom"
                                         ToolTipService.InitialShowDelay="500"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding PresetsSource, Mode=OneWay}" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <core:SpacedStackPanel Spacing="6" Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6"
                                        Tag="{Binding}"
                                        ToolTip="{Binding Name.Value}"
                                        ToolTipService.Placement="Mouse"
                                        ToolTipService.InitialShowDelay="500"
                                        Padding="12 10"
                                        BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CBackground2}"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CBackground4}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CBackground6}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                  Text="{Binding Name.Value}"
                                                  FontSize="14"
                                                  Foreground="{DynamicResource CForeground1}"
                                                  VerticalAlignment="Center"
                                                  TextTrimming="CharacterEllipsis"
                                                  Margin="0 -2 0 0"
                                                  Tag="{Binding}">
                                        </TextBlock>

                                        <Border Grid.Column="1"
                                               CornerRadius="4"
                                               Margin="12 0 0 0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                            <core:IconButton ButtonColour="Blue" Icon="Solid_ArrowRight"
                                                             Width="25" Height="25"
                                                             Click="SpawnPreset_OnClick"
                                                             Tag="{Binding}"
                                                             ToolTip="Spawn Preset"/>
                                        </Border>
                                    </Grid>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Export" Click="ExportPreset_OnClick" Tag="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Delete" Click="DeletePreset_OnClick" Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource CBackground2}"
                Visibility="{Binding NodesLoaded.Value, Converter={StaticResource BoolToVisibilityConverterInverted}}">
            <core:SpacedStackPanel Orientation="Vertical" Spacing="20" VerticalAlignment="Center">
                <TextBlock MaxWidth="400" FontSize="25" TextAlignment="Center"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource CForeground1}"
                           Text="Pulse editing is disabled due to module errors" />
            </core:SpacedStackPanel>
        </Border>
    </Grid>
</UserControl>