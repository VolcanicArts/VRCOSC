<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VRCOSC.App.UI.Views.Nodes.Controls">
    <Style TargetType="{x:Type controls:FlowDisplay}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FlowDisplay}">
                    <Grid x:Name="RootGrid">
                        <Canvas x:Name="AnimationCanvas"
                                Background="Transparent"
                                ClipToBounds="True">
                        </Canvas>
                        <TextBlock x:Name="SpawnCountDisplay"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SpawnsPerSecond}"
                                   Foreground="{DynamicResource CForeground1}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   MinWidth="30"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>